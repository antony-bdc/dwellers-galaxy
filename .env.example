# Copy to .env and adjust. .env is git-ignored.
MC_VERSION=1.20.1
FORGE_VERSION=47.3.0
MC_MEMORY=6G
MC_CONTAINER_LIMIT=8g
MC_PORT=25565
MC_MOTD=A modded homelab server
MC_MAX_PLAYERS=10
MC_VIEW_DISTANCE=10
MC_SIMULATION_DISTANCE=8
# Comma-separated Minecraft usernames
MC_WHITELIST=
MC_OPS=
# Where the Prometheus exporter listens. 127.0.0.1 = local only,
# 0.0.0.0 = reachable by the monitoring host on your LAN.
MC_METRICS_BIND=127.0.0.1
TZ=Europe/Zurich
